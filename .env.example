# Postgres
POSTGRES_USER=alshantaf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alshantaf

# Backend
DATABASE_URL=postgresql://alshantaf:change-me@postgres:5432/alshantaf
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@alshantaf.com
ADMIN_PASSWORD=change-me
# Secret unlock for the hidden admin UI. Without the exact query param (and
# without a previously trusted device cookie), /admin and /admin/login return
# a normal 404. First visit:
#   https://your-domain/admin/login?unlock=<this-value>
# That unlock sets a long-lived trusted-device cookie. After one successful login,
# that browser/homescreen app can reopen /admin (or /admin/login) without the
# unlock key. Log out only clears the session — the device stays trusted.
# Public users never see the panel. Use a long random string; never commit the real value.
ADMIN_GATE_SECRET=change-me-to-a-long-random-string
PORT=4000
NODE_ENV=production
PUBLIC_SITE_URL=https://alshantaf.com

# Outgoing email (tracking-code confirmations to applicants). Leave blank to
# skip sending — submissions still work, tracking codes just aren't emailed.
# For Squarespace-hosted email (info@alshantaf.com), get the SMTP host/port
# from Squarespace's email settings; SMTP_USER is the full email address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@alshantaf.com
SMTP_PASS=
# Outgoing SMS (owner listing updates: publish link, view milestones, sold/canceled).
# Configure EITHER Twilio OR a generic HTTP JSON gateway. Leave blank to skip SMS.
# Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Generic SMS API (POST JSON with to/message):
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Alshantaf

# Groq AI assistant (optional fallback / prompt guard)
# Get a key at https://console.groq.com — without any LLM key the widget still works
# via a deterministic fallback (DB offers/services), just without LLM replies.
GROQ_API_KEY=
# Chat model — default allam-2-7b (highest conversational RPD ~7K/day)
GROQ_MODEL=allam-2-7b
# Prompt-injection guard (classifier, ~14.4K RPD). Set GROQ_GUARD_ENABLED=0 to disable.
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_GUARD_THRESHOLD=0.85
GROQ_GUARD_ENABLED=1

# OpenAI primary assistant model (preferred when set)
# https://platform.openai.com — model gpt-6-luna
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none|low|medium|high|xhigh|max — none is fastest/cheapest for JSON planning
OPENAI_REASONING_EFFORT=none

# Frontend
NEXT_PUBLIC_API_BASE_URL=/api

# SEO / Google Search Console
# Get this from Search Console > Settings > Ownership verification > HTML tag
# method; paste only the "content" value (not the whole <meta> tag). Leave
# blank until you have a real value — no verification meta tag is rendered
# when this is unset.
GOOGLE_SITE_VERIFICATION=
