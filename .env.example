# Postgres
POSTGRES_USER=alshantaf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alshantaf

# Backend
DATABASE_URL=postgresql://alshantaf:change-me@postgres:5432/alshantaf
JWT_SECRET=change-me-to-a-long-random-string
# Optional dedicated key for encrypting investor national ID / bank details.
# Falls back to JWT_SECRET when unset.
INVEST_PII_SECRET=
ADMIN_EMAIL=admin@alshantaf.com
ADMIN_PASSWORD=change-me
# Secret unlock for the hidden admin UI. Without the exact query param (and
# without a previously trusted device cookie), /admin and /admin/login return
# a normal 404. First visit:
#   https://your-domain/admin/login?unlock=<this-value>
# That unlock sets a long-lived trusted-device cookie. After one successful login,
# that browser/homescreen app can reopen /admin (or /admin/login) without the
# unlock key. Log out only clears the session — the device stays trusted.
# Public users never see the panel. Use a long random string; never commit the real value.
ADMIN_GATE_SECRET=change-me-to-a-long-random-string
PORT=4000
NODE_ENV=production
PUBLIC_SITE_URL=https://alshantaf.com
# Brand public base for Steel Fiber customer receipt links (/o/<token>)
STEELFIBER_PUBLIC_SITE_URL=https://alwathbasteelfiber.com
# Shared secret: Steel Fiber admin proxies orders with header X-Orders-Admin-Key.
# Must match STEELFIBER_ORDERS_ADMIN_KEY on the wsteelfiber app.
STEELFIBER_ORDERS_ADMIN_KEY=change-me-to-a-long-random-string

# Outgoing email (tracking-code confirmations to applicants). Leave blank to
# skip sending — submissions still work, tracking codes just aren't emailed.
# For Squarespace-hosted email (info@alshantaf.com), get the SMTP host/port
# from Squarespace's email settings; SMTP_USER is the full email address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@alshantaf.com
SMTP_PASS=
# Outgoing SMS (owner listing updates: publish link, view milestones, sold/canceled).
# Configure EITHER Twilio OR a generic HTTP JSON gateway. Leave blank to skip SMS.
# Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Generic SMS API (POST JSON with to/message):
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Alshantaf

# OpenAI AI assistant (server-side only — never expose to the browser)
# Env values are defaults; full admins can override via Admin → Settings → AI config.
# Preferred when set. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Chat model — default gpt-6-luna ($0.10 / $0.50 per 1M input/output tokens)
OPENAI_MODEL=gpt-6-luna
OPENAI_TEMPERATURE=0.55
# none|low|medium|high — low is best for grounded JSON replies on Luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_COMPLETION_TOKENS=900

# Groq AI assistant fallback + prompt guard (optional)
# Used for chat only when OPENAI_API_KEY is unset. Guard still runs when GROQ_API_KEY is set.
# Get a key at https://console.groq.com — without any AI key the widget still works
# via a deterministic fallback (DB offers/services), just without LLM replies.
GROQ_API_KEY=
# Chat model — default allam-2-7b (highest conversational RPD ~7K/day)
GROQ_MODEL=allam-2-7b
# Lower = fewer hallucinations / more consistent tone (0.1–0.2 recommended).
GROQ_TEMPERATURE=0.15
# Prompt-injection guard (classifier, ~14.4K RPD). Set GROQ_GUARD_ENABLED=0 to disable.
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_GUARD_THRESHOLD=0.85
GROQ_GUARD_ENABLED=1

# Cloudflare Turnstile (optional). When TURNSTILE_SECRET is set, forms use
# Turnstile instead of the built-in math captcha. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile — domains: alshantaf.com
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=alshantaf.com,www.alshantaf.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=/api

# SEO / Google Search Console
# Get this from Search Console > Settings > Ownership verification > HTML tag
# method; paste only the "content" value (not the whole <meta> tag). Leave
# blank until you have a real value — no verification meta tag is rendered
# when this is unset.
GOOGLE_SITE_VERIFICATION=

# Site-work Excel workbooks (mounted at backend/data/site-work)
SITE_WORK_DATA_DIR=
# Optional Google Drive backup for project .xlsx files (service account)
GOOGLE_DRIVE_FOLDER_ID=
# Either paste the full service-account JSON, or point at a file path inside the container
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_CREDENTIALS_FILE=

