generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  whatsapp     String?
  /// Feature grants: ["*"] = full admin, or a subset of dashboard|listings|…
  permissions  String[] @default(["*"])
  createdAt    DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model IndustryTypeCatalog {
  industryType      IndustryType @id
  category          String
  ammanAutoEligible Boolean      @default(false)
  rules             Json
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model AmmanZoningObservation {
  id           String       @id @default(uuid())
  sourceKey    String       @unique
  zoningNo     String?
  zoningName   String?
  districtName String?
  industryType IndustryType?
  seenCount    Int          @default(1)
  firstSeenAt  DateTime     @default(now())
  lastSeenAt   DateTime     @updatedAt

  @@index([industryType])
  @@index([lastSeenAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

enum IndustryType {
  lightSpecial
  light
  mediumSpecial
  medium
  industrialCraft
  industrialHeavy
  industrialTransformative
  industrialGeneral
  agriToIndustrial
  technical
  residentialA
  residentialB
  residentialC
  residentialD
  residentialPopular
  residentialHighDensity
  residentialGreen
  residentialAgri
  agriFacilities
  commercialCentral
  commercialShowrooms
  commercialLinear
  commercialOffice
  commercialIndustrial
  commercialNeighborhoodService
  commercialCenter
  commercialLocal
  greenWithinA
  greenWithinB
  greenWithinC
  greenWithinD
  residentialPrivateA
  residentialPrivateB
  residentialPrivateC
  residentialRural
  commercialOrdinaryA
  commercialOrdinaryB
  commercialOrdinaryC
  commercialWithinD
  commercialComplex
  mixedUse
  mixedUseUrban
  mixedUseEntertainment
  commercialOutsideCentral
  commercialOutsideShowrooms
  commercialOutsideLinear
  commercialOutsideLocal
}

enum DealType {
  sale
  rent
  sale_or_rent
  partnership
}

enum PropertyStatus {
  available
  reserved
  sold
  rented
  canceled
}

enum PublishStatus {
  published
  draft
  archived
}

/// Editorial ranking for public offers (admin-only). Titanium appears on the landing page.
enum OfferImportance {
  none
  golden
  platinum
  titanium
}

enum PresenterRole {
  owner
  presenter
  broker
  company
  other
}

enum MediaKind {
  image
  video
  document
}

model Listing {
  id             String         @id @default(uuid())
  listingNo      String         @unique
  title          String
  area           String
  propertyType   String?
  industryType   IndustryType
  dealType       DealType       @default(sale)
  size           String?
  price          String?
  governorate    String?
  directorate    String?
  village        String?
  basin          String?
  neighborhood   String?
  parcel         String?
  locationUrl    String?
  latitude       Float?
  longitude      Float?
  address        String?
  administrativeValue       Float?
  administrativeValueSource String?
  administrativeValueAt     DateTime?
  phone          String?
  status         PropertyStatus @default(available)
  publishStatus  PublishStatus  @default(draft)
  featured       Boolean        @default(false)
  /// golden | platinum | titanium — admin-curated prominence (featured stays synced with titanium)
  importance     OfferImportance @default(none)
  /// Secret code for the owner portal (/my-offer/[code]) — SMS/link access, not public.
  ownerAccessCode String?       @unique
  /// When true, milestone/status SMS may be sent to `phone`.
  smsOptIn       Boolean        @default(true)
  /// View milestones already SMS-notified (10, 25, 50, …).
  notifiedMilestones Int[]      @default([])
  presenterRole  PresenterRole?
  presenterName  String?
  showPresenter  Boolean        @default(false)
  /// When false, public offer hides the DLS mid-range (rate × area) estimate.
  showEstimatedValue Boolean    @default(true)
  description    String
  internalNotes  String?
  mainImage      String?
  source         String         @default("admin")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  viewCount      Int            @default(0)

  media       Media[]
  submissions Submission[]
  views       ListingView[]

  @@index([area])
  @@index([publishStatus])
  @@index([status])
  @@index([importance])
}

enum LandCheckStatus {
  new
  contacted
  closed
}

enum ContactRequestStatus {
  new
  contacted
  closed
}

/// Public contact-form requests (“أرسل تفاصيل طلبك”) for admin follow-up.
model ContactRequest {
  id           String               @id @default(uuid())
  serialNo     String               @unique
  name         String
  phone        String
  requestType  String
  industryType String?
  activityType String?
  details      String
  status       ContactRequestStatus @default(new)
  adminNotes   String?
  reviewer     String?
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())

  @@index([status])
  @@index([createdAt])
}

/// Public land identity / regulation checks that are NOT listing submissions.
/// Admins review these for follow-up; nothing here is published as an offer.
/// Incomplete forms are auto-saved as drafts (isDraft=true) via clientKey.
model LandCheck {
  id           String          @id @default(uuid())
  serialNo     String          @unique
  /// Browser-stable key so drafts upsert without requiring Save.
  clientKey    String?         @unique
  isDraft      Boolean         @default(false)
  name         String?
  phone        String?
  email        String?
  governorate  String?
  directorate  String?
  village      String?
  basin        String?
  neighborhood String?
  parcel       String?
  coordinates  String?
  latitude     Float?
  longitude    Float?
  address      String?
  dlsKey       String?
  areaSqm      Float?
  areaLabel    String?
  perimeterM   Float?
  administrativeValue       Float?
  administrativeValueSource String?
  administrativeValueAt     DateTime?
  estimatedMedian           Float?
  industryType IndustryType?
  notes        String?
  status       LandCheckStatus @default(new)
  adminNotes   String?
  reviewer     String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([isDraft])
  @@index([village, basin, parcel])
}

/// One row per (listing, visitor) pair so repeat visits from the same browser
/// don't inflate the view count; the unique constraint is the dedupe mechanism.
model ListingView {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  visitorId String
  viewedAt  DateTime @default(now())

  @@unique([listingId, visitorId])
  @@index([listingId])
}

model Media {
  id        String    @id @default(uuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  kind      MediaKind
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([listingId])
}

/// Reusable admin-curated images that can be attached during submission approval.
model StandbyImage {
  id        String   @id @default(uuid())
  url       String   @unique
  title     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum SubmissionSource {
  owner
  broker
}

enum SubmissionStatus {
  pending
  duplicate_review
  needs_info
  approved
  rejected
}

model Submission {
  id           String           @id @default(uuid())
  serialNo     String           @unique
  trackingCode String           @unique
  source       SubmissionSource
  applicant    String
  phone        String
  office       String?
  whatsapp     String?
  email        String?
  authExpiry   String?
  governorate  String?
  directorate  String?
  village      String?
  basin        String?
  parcel       String?
  neighborhood String?
  coordinates  String?
  latitude     Float?
  longitude    Float?
  address      String?
  administrativeValue       Float?
  administrativeValueSource String?
  administrativeValueAt     DateTime?
  dlsKey       String?
  area         String?
  price        String?
  industryType IndustryType?
  activity     String?
  details      String
  images       String[]         @default([])
  video        String?
  document     String?
  duplicate    Boolean          @default(false)
  status       SubmissionStatus @default(pending)
  reviewer     String?
  reviewNote   String?
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?

  convertedListingId String?
  convertedListing   Listing? @relation(fields: [convertedListingId], references: [id], onDelete: SetNull)

  @@index([status])
}

/// Official / institutional data provider for market intelligence.
model MarketSource {
  id               String   @id @default(uuid())
  key              String   @unique
  name             String
  tier             Int
  url              String
  country          String   @default("JO")
  sourceType       String
  updateFrequency  String
  reliability      String   @default("official")
  lastChecked      DateTime?
  lastSuccessAt    DateTime?
  nextExpectedAt   DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  metrics          MarketMetric[]
}

/// Normalized observation for a single market KPI at a given period.
model MarketMetric {
  id                 String       @id @default(uuid())
  metricKey          String
  metricName         String
  category           String
  value              Float
  unit               String
  currency           String?
  periodStart        DateTime
  periodEnd          DateTime
  frequency          String
  sourceId           String
  source             MarketSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceUrl          String
  sourcePublishedAt  DateTime?
  retrievedAt        DateTime     @default(now())
  status             String       @default("latest_available")
  isEstimate         Boolean      @default(false)
  isCalculated       Boolean      @default(false)
  confidence         String       @default("high")
  previousValue      Float?
  changePercent      Float?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  revisions          MarketMetricRevision[]

  @@unique([metricKey, periodEnd, sourceId])
  @@index([metricKey, periodEnd])
  @@index([category])
  @@index([retrievedAt])
}

/// Preserve original retrieved values when a figure is revised.
model MarketMetricRevision {
  id            String       @id @default(uuid())
  metricId      String
  metric        MarketMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  previousValue Float
  newValue      Float
  revisedAt     DateTime     @default(now())
  note          String?
}

/// Aggregated daily site page views (analytics-consent path only).
/// `views` is kept equal to unique device hits (one count per visitor/day/path at most).
model SitePageViewDaily {
  id             String   @id @default(uuid())
  day            DateTime @db.Date
  path           String   @default("/")
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([day, path])
  @@index([day])
}

/// One row per visitor device per UTC day — source of truth for unique-device view counts.
model SiteVisitorDaily {
  id        String   @id @default(uuid())
  day       DateTime @db.Date
  visitorId String
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@unique([day, visitorId])
  @@index([day])
  @@index([visitorId])
}

/// One row per browser/device (visitor cookie). Optional display name sticks for life.
model SiteDevice {
  id           String            @id @default(uuid())
  visitorId    String            @unique
  displayName  String?
  /// Once a visitor sets their own name, it cannot be overwritten by another visitor prompt.
  nameLocked   Boolean           @default(false)
  namedAt      DateTime?
  ip           String?
  userAgent    String?
  language     String?
  platform     String?
  screen       String?
  timezone     String?
  lastPath     String            @default("/")
  requestCount Int               @default(0)
  firstSeenAt  DateTime          @default(now())
  lastSeenAt   DateTime          @default(now())
  events       SiteDeviceEvent[]

  @@index([ip])
  @@index([lastSeenAt])
  @@index([displayName])
}

/// Individual tracked requests / heartbeats for the monitor detail view.
model SiteDeviceEvent {
  id        String     @id @default(uuid())
  deviceId  String
  device    SiteDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ip        String?
  path      String
  userAgent String?
  createdAt DateTime   @default(now())

  @@index([deviceId, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// Daily unique-IP rollup for dashboard cards.
model SiteIpDaily {
  id      String   @id @default(uuid())
  day     DateTime @db.Date
  ip      String
  hits    Int      @default(0)
  devices Int      @default(0)

  @@unique([day, ip])
  @@index([day])
}

/// Brand-scoped customer order / receipt (Alshantaf or Steel Fiber).
enum OrderBrand {
  alshantaf
  steelfiber
}

enum OrderKind {
  payments
  installments
  one_time
  service
}

enum OrderStatus {
  open
  closed
  void
}

enum OrderInstallmentStatus {
  due
  paid
  skipped
}

model CustomerOrder {
  id             String        @id @default(uuid())
  serialNo       String        @unique
  brand          OrderBrand
  kind           OrderKind
  status         OrderStatus   @default(open)
  customerName   String
  customerPhone  String?
  title          String
  notes          String?
  currency       String        @default("JOD")
  /// Snapshot total in major units (JOD). Recalculated from lines / installments / payments.
  totalAmount    Decimal       @default(0) @db.Decimal(14, 3)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 3)
  createdByEmail String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lines          OrderLine[]
  payments       OrderPayment[]
  installments   OrderInstallment[]
  accessTokens   OrderAccessToken[]

  @@index([brand, createdAt])
  @@index([brand, status])
  @@index([customerPhone])
  @@map("orders")
}

model OrderLine {
  id          String        @id @default(uuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal       @default(1) @db.Decimal(14, 3)
  unitAmount  Decimal       @default(0) @db.Decimal(14, 3)
  amount      Decimal       @default(0) @db.Decimal(14, 3)
  sortOrder   Int           @default(0)

  @@index([orderId])
}

model OrderPayment {
  id        String        @id @default(uuid())
  orderId   String
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(14, 3)
  paidAt    DateTime      @default(now())
  method    String?
  note      String?
  markedBy  String

  @@index([orderId])
  @@index([paidAt])
}

model OrderInstallment {
  id        String                 @id @default(uuid())
  orderId   String
  order     CustomerOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dueDate   DateTime               @db.Date
  amount    Decimal                @db.Decimal(14, 3)
  status    OrderInstallmentStatus @default(due)
  paidAt    DateTime?
  note      String?
  sortOrder Int                    @default(0)

  @@index([orderId])
  @@index([dueDate])
}

model OrderAccessToken {
  id          String        @id @default(uuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the raw public token (raw token never stored).
  tokenHash   String        @unique
  /// First chars of raw token for admin recognition (e.g. "a1b2c3…").
  tokenPrefix String
  createdAt   DateTime      @default(now())
  revokedAt   DateTime?

  @@index([orderId])
}

/// Site engineer account for the Arabic /site daily-counts portal.
model SiteEngineer {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  name         String
  phone        String?
  /// ENGINEER = field engineer; COORDINATOR = pays / owns project expenses (منسق).
  role         String               @default("ENGINEER")
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  projects     SiteProjectEngineer[]
  records      SiteDailyRecord[]
  /// Projects this person leads as main coordinator (المنسق).
  coordinatedProjects SiteProject[] @relation("SiteProjectCoordinator")
  expenses     SiteExpense[]
}

model SiteProject {
  id              String               @id @default(uuid())
  name            String
  code            String?
  notes           String?
  active          Boolean              @default(true)
  /// Relative path under SITE_WORK_DATA_DIR for the project workbook.
  excelFilename   String?
  /// Google Drive file id when Drive backup is configured.
  driveFileId     String?
  /// Highest week number seen/created in the workbook.
  weekCounter     Int                  @default(0)
  /// Main coordinator engineer responsible for this project's expenses.
  coordinatorId   String?
  coordinator     SiteEngineer?        @relation("SiteProjectCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  /// Optional planned budget (JOD) to compare against spend.
  budget          Decimal?             @db.Decimal(14, 3)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  expenses        SiteExpense[]
  engineers       SiteProjectEngineer[]
  workers         SiteProjectWorker[]
  records         SiteDailyRecord[]
  payouts         SiteWorkerWeekPayout[]

  @@index([coordinatorId])
}

model SiteWorker {
  id           String             @id @default(uuid())
  name         String
  /// Legal / settlement full name when different from short display name.
  fullName     String?
  employeeCode String?
  notes        String?
  /// Flat daily wage for a worked day (Jordanian dinars).
  dailyPay     Decimal            @default(0) @db.Decimal(10, 3)
  /// Pay per overtime / extra hour.
  extraHourPay Decimal            @default(0) @db.Decimal(10, 3)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  projects     SiteProjectWorker[]
  records      SiteDailyRecord[]
  payouts      SiteWorkerWeekPayout[]
}

model SiteProjectEngineer {
  projectId  String
  engineerId String
  project    SiteProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engineer   SiteEngineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@id([projectId, engineerId])
  @@index([engineerId])
}

model SiteProjectWorker {
  projectId   String
  workerId    String
  project     SiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker      SiteWorker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  /// Short name shown in Excel name cell (الإسم).
  displayName String?
  jobTitle    String?
  hourlyRate  Decimal     @default(0) @db.Decimal(8, 3)
  sortOrder   Int         @default(0)
  assignedAt  DateTime    @default(now())

  @@id([projectId, workerId])
  @@index([workerId])
}

/// One attendance / hours row per worker per project per calendar day.
model SiteDailyRecord {
  id           String       @id @default(uuid())
  projectId    String
  workerId     String
  engineerId   String
  workDate     DateTime     @db.Date
  regularHours Decimal      @default(0) @db.Decimal(6, 2)
  extraHours   Decimal      @default(0) @db.Decimal(6, 2)
  otherWorks   String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      SiteProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker       SiteWorker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  engineer     SiteEngineer @relation(fields: [engineerId], references: [id], onDelete: Restrict)

  @@unique([projectId, workerId, workDate])
  @@index([workDate])
  @@index([engineerId])
  @@index([workerId])
}

/// Weekly paycheck for a worker on a project (admin marks paid).
model SiteWorkerWeekPayout {
  id              String      @id @default(uuid())
  workerId        String
  projectId       String
  weekStart       DateTime    @db.Date
  daysWorked      Int         @default(0)
  totalExtraHours Decimal     @default(0) @db.Decimal(8, 2)
  dailyPay        Decimal     @default(0) @db.Decimal(10, 3)
  extraHourPay    Decimal     @default(0) @db.Decimal(10, 3)
  amount          Decimal     @default(0) @db.Decimal(12, 3)
  paid            Boolean     @default(false)
  paidAt          DateTime?
  paidBy          String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  worker          SiteWorker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project         SiteProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workerId, projectId, weekStart])
  @@index([projectId, weekStart])
  @@index([workerId, paid])
}

/// Expense entered by a site engineer: either tied to a project or a general company expense.
model SiteExpense {
  id            String       @id @default(uuid())
  /// "PROJECT" or "COMPANY"
  scope         String       @default("PROJECT")
  projectId     String?
  engineerId    String
  category      String
  description   String
  amount        Decimal      @db.Decimal(12, 3)
  expenseDate   DateTime     @db.Date
  vendor        String?
  /// cash | transfer | cheque | card | credit
  paymentMethod String?
  invoiceNo     String?
  /// Stored filename under SITE_WORK_DATA_DIR/receipts (private; served via auth route).
  receiptFile   String?
  receiptMime   String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       SiteProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  engineer      SiteEngineer @relation(fields: [engineerId], references: [id], onDelete: Restrict)

  @@index([projectId, expenseDate])
  @@index([engineerId, expenseDate])
  @@index([scope, expenseDate])
  @@index([expenseDate])
}

// ─────────────────────────────────────────────────────────────
// Investment partnership management (land co-investment)
// ─────────────────────────────────────────────────────────────

enum InvProjectStatus {
  draft
  fundraising
  capital_collection
  acquisition_pending
  acquired
  active_management
  listed_for_sale
  sale_pending
  sold
  settlement_pending
  settled
  closed
  cancelled
}

enum InvApprovalStatus {
  draft
  pending
  approved
  rejected
  reversed
}

enum InvContributionKind {
  initial
  additional
  capital_call
  adjustment
  withdrawal
}

enum InvExpenseStatus {
  pending
  approved
  rejected
  reimbursed
  written_off
}

enum InvCommissionBasis {
  investor_net_profit
  distributable_profit
  sale_value
  fixed
  hybrid
}

enum InvJournalStatus {
  draft
  posted
  reversed
}

enum InvSettlementStatus {
  draft
  pending_approval
  approved
  posted
  paid
  cancelled
}

enum InvDocumentKind {
  land_deed
  purchase_agreement
  sale_agreement
  investor_contract
  receipt
  legal
  expense_invoice
  bank_transfer
  property_photo
  valuation
  statement
  other
}

model InvOrganization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  baseCurrency String   @default("JOD") @db.VarChar(3)
  timezone     String   @default("Asia/Amman")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investors InvInvestor[]
  projects  InvProject[]
  accounts  InvLedgerAccount[]
}

model InvInvestor {
  id              String    @id @default(uuid())
  organizationId  String
  organization    InvOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName       String
  displayName     String?
  /// Human-friendly partner number (P-0001), unique per organization.
  code            String?
  /// individual | company
  kind            String    @default("individual")
  email           String?
  phone           String?
  /// Encrypted-at-rest payload (AES-GCM); never returned in list APIs.
  nationalIdEnc   String?
  /// HMAC blind index of the normalized national ID (exact-match search without decrypting).
  nationalIdHash  String?
  nationalIdLast4 String?
  city            String?
  address         String?
  /// Encrypted bank details JSON.
  bankDetailsEnc  String?
  verificationStatus String @default("unverified")
  notes           String?
  /// Admin User this partner profile belongs to (the coordinator's own profile).
  userId          String?   @unique
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   InvMembership[]
  contributions InvContribution[]
  expensesPaid  InvExpense[]      @relation("ExpensePayer")
  portalUser    InvPortalUser?
  documents     InvDocument[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([email])
  @@index([legalName])
  @@index([nationalIdHash])
  @@index([phone])
}

/// Investor-facing login (separate from admin User).
model InvPortalUser {
  id           String      @id @default(uuid())
  investorId   String      @unique
  investor     InvInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  email        String      @unique
  passwordHash String
  active       Boolean     @default(true)
  locale       String      @default("ar")
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model InvProject {
  id               String           @id @default(uuid())
  organizationId   String
  organization     InvOrganization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  referenceNo      String
  description      String?
  country          String           @default("JO")
  city             String?
  area             String?
  landLocation     String?
  plotParcelNo     String?
  landAreaSqm      Decimal?         @db.Decimal(18, 3)
  purchasePrice    Decimal?         @db.Decimal(18, 3)
  targetSalePrice  Decimal?         @db.Decimal(18, 3)
  purchaseDate     DateTime?        @db.Date
  expectedSaleDate DateTime?        @db.Date
  actualSalePrice  Decimal?         @db.Decimal(18, 3)
  actualSaleDate   DateTime?        @db.Date
  currency         String           @default("JOD") @db.VarChar(3)
  currencyScale    Int              @default(3)
  status           InvProjectStatus @default(draft)
  /// Coordinator admin user id (User.id) when known.
  coordinatorUserId String?
  /// Membership marked isCoordinator mirrors operational coordinator partner.
  waterfallSteps   Json?
  /// Default commission rule JSON (CommissionRuleInput shape).
  commissionRule   Json?
  coordinatorParticipatesInProfit Boolean @default(true)
  /// Share a sale shortfall by ownership instead of strict capital-first.
  shareLossesByOwnership Boolean @default(true)
  agreementNotes   String?
  /// Purchase contract: seller, deed, registry, down payment, seller installments (JSON).
  contractDetails  Json?
  /// Latest valuation assumption for the land (what it is worth today).
  estimatedValue     Decimal?       @db.Decimal(18, 3)
  estimatedValueDate DateTime?      @db.Date
  estimatedValueNote String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  closedAt         DateTime?

  memberships      InvMembership[]
  contributions    InvContribution[]
  expenses         InvExpense[]
  statusHistory    InvProjectStatusEvent[]
  documents        InvDocument[]
  journals         InvJournal[]
  settlements      InvSettlement[]
  commissionRules  InvCommissionRule[]
  transactions     InvTransaction[]

  @@unique([organizationId, referenceNo])
  @@index([organizationId, status])
  @@index([status])
}

model InvProjectStatusEvent {
  id         String           @id @default(uuid())
  projectId  String
  project    InvProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus InvProjectStatus?
  toStatus   InvProjectStatus
  note       String?
  actorId    String?
  actorEmail String?
  createdAt  DateTime         @default(now())

  @@index([projectId, createdAt])
}

model InvMembership {
  id                String      @id @default(uuid())
  projectId         String
  project           InvProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId        String
  investor          InvInvestor @relation(fields: [investorId], references: [id], onDelete: Restrict)
  isCoordinator     Boolean     @default(false)
  /// Explicit ownership override (0–100). Null → derived from equity capital.
  ownershipPercent  Decimal?    @db.Decimal(12, 8)
  roleLabel         String?
  /// Optional per-investor commission override JSON.
  commissionOverride Json?
  /// Coordinator cut % on this partner's profit (null = project default, 0 = exempt).
  commissionPercent Decimal?  @db.Decimal(8, 4)
  notes             String?
  joinedAt          DateTime    @default(now())
  leftAt            DateTime?
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([projectId, investorId])
  @@index([investorId])
}

model InvContribution {
  id             String               @id @default(uuid())
  projectId      String
  project        InvProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId     String
  investor       InvInvestor          @relation(fields: [investorId], references: [id], onDelete: Restrict)
  kind           InvContributionKind  @default(initial)
  amount         Decimal              @db.Decimal(18, 3)
  currency       String               @db.VarChar(3)
  contributedAt  DateTime             @db.Date
  description    String?
  /// cash | bank_transfer | cheque | other
  paymentMethod  String?
  /// Transfer / cheque / receipt number.
  paymentRef     String?
  /// Counts toward ownership equity pool.
  countsAsEquity Boolean              @default(true)
  approvalStatus InvApprovalStatus    @default(approved)
  approvedBy     String?
  approvedAt     DateTime?
  journalId      String?
  createdBy      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([projectId, contributedAt])
  @@index([investorId])
}

model InvExpense {
  id               String           @id @default(uuid())
  projectId        String
  project          InvProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payerInvestorId  String?
  payerInvestor    InvInvestor?     @relation("ExpensePayer", fields: [payerInvestorId], references: [id], onDelete: SetNull)
  /// When coordinator/admin paid from company funds without an investor profile.
  paidByCoordinator Boolean         @default(false)
  title            String
  category         String?
  description      String?
  amount           Decimal          @db.Decimal(18, 3)
  currency         String           @db.VarChar(3)
  expenseDate      DateTime         @db.Date
  status           InvExpenseStatus @default(pending)
  reimbursementDue Decimal          @db.Decimal(18, 3) @default(0)
  reimbursementPaid Decimal         @db.Decimal(18, 3) @default(0)
  approvedBy       String?
  approvedAt       DateTime?
  rejectedReason   String?
  /// Who bears the cost: ownership (default) | equal | custom.
  splitMode        String           @default("ownership")
  /// custom: { investorId: percent } summing to 100.
  splitShares      Json?
  createdBy        String?
  /// Maker id — cannot equal approvedBy (maker-checker).
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  journalId        String?
  documents        InvDocument[]

  @@index([projectId, status])
  @@index([payerInvestorId])
}

model InvCommissionRule {
  id        String             @id @default(uuid())
  projectId String
  project   InvProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  basis     InvCommissionBasis
  percent   Decimal?           @db.Decimal(8, 4)
  fixedAmount Decimal?         @db.Decimal(18, 3)
  perInvestorJson Json?
  chargeOnCoordinatorProfit Boolean @default(true)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([projectId, active])
}

model InvLedgerAccount {
  id             String          @id @default(uuid())
  organizationId String
  organization   InvOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  accountType    String
  currency       String          @default("JOD") @db.VarChar(3)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())

  lines InvJournalLine[]

  @@unique([organizationId, code])
}

model InvJournal {
  id              String           @id @default(uuid())
  projectId       String?
  project         InvProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organizationId  String
  status          InvJournalStatus @default(draft)
  memo            String?
  valueDate       DateTime         @db.Date
  postedAt        DateTime?
  postedBy        String?
  /// Links to reversed original when this is a reversing journal.
  reversesJournalId String?
  reversesJournal   InvJournal?  @relation("JournalReversal", fields: [reversesJournalId], references: [id])
  reversedBy        InvJournal[] @relation("JournalReversal")
  idempotencyKey  String?
  createdBy       String?
  createdAt       DateTime         @default(now())
  lines           InvJournalLine[]
  transactions    InvTransaction[]

  @@unique([organizationId, idempotencyKey])
  @@index([projectId, status])
}

model InvJournalLine {
  id          String           @id @default(uuid())
  journalId   String
  journal     InvJournal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   String
  account     InvLedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  partnerId   String?
  debit       Decimal          @db.Decimal(18, 3) @default(0)
  credit      Decimal          @db.Decimal(18, 3) @default(0)
  currency    String           @db.VarChar(3)
  memo        String?
  lineNo      Int

  @@index([journalId])
  @@index([accountId])
}

/// Operational transaction register (every money movement has a row).
model InvTransaction {
  id              String            @id @default(uuid())
  projectId       String
  project         InvProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partnerId       String?
  type            String
  amount          Decimal           @db.Decimal(18, 3)
  currency        String            @db.VarChar(3)
  transactionDate DateTime          @db.Date
  description     String?
  approvalStatus  InvApprovalStatus @default(pending)
  createdBy       String?
  journalId       String?
  journal         InvJournal?       @relation(fields: [journalId], references: [id], onDelete: SetNull)
  metadata        Json?
  createdAt       DateTime          @default(now())

  @@index([projectId, transactionDate])
  @@index([partnerId])
}

model InvSettlement {
  id              String              @id @default(uuid())
  projectId       String
  project         InvProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status          InvSettlementStatus @default(draft)
  saleProceeds    Decimal             @db.Decimal(18, 3)
  closingCosts    Decimal             @db.Decimal(18, 3) @default(0)
  unpaidLiabilities Decimal           @db.Decimal(18, 3) @default(0)
  currency        String              @db.VarChar(3)
  resultJson      Json?
  hypothetical    Boolean             @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  postedBy        String?
  postedAt        DateTime?
  createdBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lines           InvSettlementLine[]

  @@index([projectId, status])
}

model InvSettlementLine {
  id                   String        @id @default(uuid())
  settlementId         String
  settlement           InvSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  partnerId            String
  label                String
  isCoordinator        Boolean       @default(false)
  ownershipPercent     Decimal       @db.Decimal(12, 8) @default(0)
  capitalReturned      Decimal       @db.Decimal(18, 3) @default(0)
  expenseReimbursement Decimal       @db.Decimal(18, 3) @default(0)
  grossProfit          Decimal       @db.Decimal(18, 3) @default(0)
  commissionPaid       Decimal       @db.Decimal(18, 3) @default(0)
  profitShare          Decimal       @db.Decimal(18, 3) @default(0)
  commissionEarned     Decimal       @db.Decimal(18, 3) @default(0)
  totalPayout          Decimal       @db.Decimal(18, 3) @default(0)
  paidAmount           Decimal       @db.Decimal(18, 3) @default(0)
  paidAt               DateTime?
  paidRef              String?

  @@index([settlementId])
  @@index([partnerId])
}

model InvDocument {
  id          String          @id @default(uuid())
  projectId   String?
  project     InvProject?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investorId  String?
  investor    InvInvestor?    @relation(fields: [investorId], references: [id], onDelete: Cascade)
  expenseId   String?
  expense     InvExpense?     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  kind        InvDocumentKind @default(other)
  name        String
  storageKey  String
  mimeType    String?
  sizeBytes   Int?
  uploadedBy  String?
  createdAt   DateTime        @default(now())

  @@index([projectId])
  @@index([investorId])
}

model InvAuditEvent {
  id            String   @id @default(uuid())
  organizationId String?
  actorId       String?
  actorEmail    String?
  action        String
  entityType    String
  entityId      String?
  previousState Json?
  newState      Json?
  reason        String?
  correlationId String?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ─────────────────────────────────────────────────────────────
// Admin investment assistant (separate from the public website assistant:
// own conversations, own memory, never shared with the site chat).
// ─────────────────────────────────────────────────────────────

model InvAgentConversation {
  id        String            @id @default(uuid())
  /// Admin User.id that owns the conversation.
  userId    String
  title     String            @default("محادثة جديدة")
  /// Project the chat was opened from (context), if any.
  projectId String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  InvAgentMessage[]

  @@index([userId, updatedAt])
}

model InvAgentMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   InvAgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant | tool
  role           String
  content        String               @default("")
  /// Assistant tool calls (OpenAI format) for replaying the conversation.
  toolCalls      Json?
  toolCallId     String?
  /// Files the admin attached: [{ documentId, name, mime }]
  attachments    Json?
  /// What the assistant changed this turn, for the UI: [{ label, href }]
  actions        Json?
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

/// Long-lived notes the assistant keeps about how this admin works (per admin user).
model InvAgentMemory {
  id        String   @id @default(uuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
